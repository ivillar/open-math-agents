import OMAStatements.S_mo_317431
import Mathlib

-- Problem: mo-317431, if S meets every open set U only together with closure(S) \ S, is the
-- topology generated by the open sets and S still connected?
-- Credit: @ivillar (the owner of the agent is credited as the solver)
--
-- No. On the real line let S be the set of rationals x <= 0. Every open set meeting S contains
-- a negative irrational, which is in the closure of S but not in S. In the topology generated
-- by the usual open sets and S, the set (-inf, 0] = (-inf, 0) u S is open and so is its
-- complement (0, inf), so the new topology is not connected.

theorem OMA.disproof : ¬ (type_of% @OMA.S_mo_317431.main) := by
  intro h
  obtain ⟨S, hSdef⟩ : ∃ S : Set ℝ, S = {x : ℝ | x ≤ 0 ∧ ∃ q : ℚ, (q : ℝ) = x} := ⟨_, rfl⟩
  have hS0 : (0 : ℝ) ∈ S := by
    rw [hSdef]
    exact ⟨le_rfl, 0, by simp⟩
  have hSle : ∀ x ∈ S, x ≤ 0 := by
    intro x hx
    rw [hSdef] at hx
    exact hx.1
  have hhyp : ∀ U : Set ℝ, IsOpen U → (U ∩ S).Nonempty → (U ∩ (closure S \ S)).Nonempty := by
    rintro U hU ⟨x, hxU, hxS⟩
    obtain ⟨ε, hε, hball⟩ := Metric.isOpen_iff.mp hU x hxU
    obtain ⟨y, hyirr, hy1, hy2⟩ := exists_irrational_btwn (show x - ε < x by linarith)
    have hx0 := hSle x hxS
    refine ⟨y, hball ?_, ?_, ?_⟩
    · rw [Metric.mem_ball, Real.dist_eq, abs_lt]
      constructor <;> linarith
    · rw [Metric.mem_closure_iff]
      intro δ hδ
      obtain ⟨q, hq1, hq2⟩ := exists_rat_btwn (show y - δ < y by linarith)
      refine ⟨(q : ℝ), ?_, ?_⟩
      · rw [hSdef]
        exact ⟨by linarith, q, rfl⟩
      · rw [Real.dist_eq, abs_lt]
        constructor <;> linarith
    · rw [hSdef]
      rintro ⟨-, q, hq⟩
      exact hyirr ⟨q, hq⟩
  have hconn0 := h ℝ S hhyp
  obtain ⟨G, hG⟩ : ∃ G : Set (Set ℝ), G = {U : Set ℝ | IsOpen U} ∪ {S} := ⟨_, rfl⟩
  rw [← hG] at hconn0
  have hIio : Set.Iio (0 : ℝ) ∈ G := by
    rw [hG]
    refine Set.mem_union_left _ ?_
    show IsOpen (Set.Iio (0 : ℝ))
    exact isOpen_Iio
  have hIoi : Set.Ioi (0 : ℝ) ∈ G := by
    rw [hG]
    refine Set.mem_union_left _ ?_
    show IsOpen (Set.Ioi (0 : ℝ))
    exact isOpen_Ioi
  have hSmem : S ∈ G := by
    rw [hG]
    exact Set.mem_union_right _ (Set.mem_singleton S)
  have hEq : Set.Iic (0 : ℝ) = Set.Iio 0 ∪ S := by
    ext x
    constructor
    · intro hx
      rcases lt_or_eq_of_le (Set.mem_Iic.mp hx) with hlt | heq
      · exact Set.mem_union_left _ (Set.mem_Iio.mpr hlt)
      · exact Set.mem_union_right _ (heq ▸ hS0)
    · rintro (hx | hx)
      · exact Set.mem_Iic.mpr (le_of_lt (Set.mem_Iio.mp hx))
      · exact Set.mem_Iic.mpr (hSle x hx)
  obtain ⟨τ', hτ'⟩ : ∃ τ' : TopologicalSpace ℝ, τ' = TopologicalSpace.generateFrom G :=
    ⟨TopologicalSpace.generateFrom G, rfl⟩
  have hconn : @ConnectedSpace ℝ τ' := by
    rw [hτ']
    exact hconn0
  have o1 : @IsOpen ℝ τ' (Set.Iio 0) := by
    rw [hτ']
    exact TopologicalSpace.isOpen_generateFrom_of_mem hIio
  have o2 : @IsOpen ℝ τ' (Set.Ioi 0) := by
    rw [hτ']
    exact TopologicalSpace.isOpen_generateFrom_of_mem hIoi
  have o3 : @IsOpen ℝ τ' S := by
    rw [hτ']
    exact TopologicalSpace.isOpen_generateFrom_of_mem hSmem
  have key : Set.Iic (0 : ℝ) = ∅ ∨ Set.Iic (0 : ℝ) = Set.univ := by
    let _inst : TopologicalSpace ℝ := τ'
    have hc : ConnectedSpace ℝ := hconn
    have o4 : IsOpen (Set.Iic (0 : ℝ)) := by
      rw [hEq]
      exact IsOpen.union o1 o3
    have c4 : IsClosed (Set.Iic (0 : ℝ)) := by
      rw [← isOpen_compl_iff, Set.compl_Iic]
      exact o2
    exact isClopen_iff.mp ⟨c4, o4⟩
  rcases key with hemp | huniv
  · have h0 : (0 : ℝ) ∈ Set.Iic (0 : ℝ) := Set.mem_Iic.mpr le_rfl
    rw [hemp] at h0
    exact h0
  · have h1 : (1 : ℝ) ∈ Set.Iic (0 : ℝ) := by
      rw [huniv]
      exact Set.mem_univ 1
    have h1' : (1 : ℝ) ≤ 0 := h1
    linarith
