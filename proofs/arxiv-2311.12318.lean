import OMAStatements.S_arxiv_2311_12318
import Mathlib

-- Problem: arxiv-2311.12318, every 3-cube-free subset of Z_N has at most 2N/3 elements, and for
-- 3 | N the residues 1, 2 modulo 3 give a 3-cube-free set of that size (Meng, arXiv:2311.12318,
-- Theorems 3.1 and 2.1).
-- Credit: @ivillar (the owner of the agent is credited as the solver)
--
-- The argument follows the proofs in the source; the Lean proof is our own.

/-!
Proof of the first claim of the abstract of arXiv:2311.12318, following Theorem 3.1 and
Theorem 2.1 of the source. Upper bound: if `A` contains some `x` together with `2x`, the cubes
generated by `{x, x, y}` show that `A`, `A - x` and `A - 2x` have no common point, so
`3 |A| ≤ 2 N`; otherwise `A` is disjoint from `2 · A`, and doubling is at most two-to-one, so
`|A| + |A| / 2 ≤ N`. Tightness: residues `1, 2` modulo `3` cannot support a projective 3-cube,
by a finite check in `ZMod 3`.
-/

namespace F2Cube

open Finset

theorem three_sets {α : Type*} [DecidableEq α] [Fintype α] (A B C : Finset α)
    (h : A ∩ B ∩ C = ∅) : A.card + B.card + C.card ≤ 2 * Fintype.card α := by
  have h1 := Finset.card_union_add_card_inter A B
  have h2 := Finset.card_union_add_card_inter (A ∩ B) C
  rw [h, Finset.card_empty] at h2
  have h3 : (A ∪ B).card ≤ Fintype.card α := Finset.card_le_univ _
  have h4 : (A ∩ B ∪ C).card ≤ Fintype.card α := Finset.card_le_univ _
  omega

theorem two_torsion {N : ℕ} [NeZero N] (t : ZMod N) (h : t + t = 0) :
    t = 0 ∨ t = ((N / 2 : ℕ) : ZMod N) := by
  have hv : t.val < N := ZMod.val_lt t
  have h1 : ((t.val + t.val : ℕ) : ZMod N) = 0 := by
    push_cast
    rw [ZMod.natCast_zmod_val]
    exact h
  rw [ZMod.natCast_eq_zero_iff] at h1
  obtain ⟨c, hc⟩ := h1
  have hc2 : c < 2 := by
    by_contra hcon
    have h2 : N * 2 ≤ N * c := Nat.mul_le_mul_left _ (by omega)
    omega
  interval_cases c
  · left
    have h2 : t.val = 0 := by omega
    exact (ZMod.val_eq_zero t).mp h2
  · right
    have h2 : t.val = N / 2 := by omega
    rw [← h2, ZMod.natCast_zmod_val]

theorem fiber_le {N : ℕ} [NeZero N] (A : Finset (ZMod N)) (a : ZMod N) :
    (A.filter (fun y => y + y = a)).card ≤ 2 := by
  by_cases hne : (A.filter (fun y => y + y = a)).Nonempty
  · obtain ⟨y0, hy0⟩ := hne
    rw [Finset.mem_filter] at hy0
    have hsub : A.filter (fun y => y + y = a) ⊆ {y0, y0 + ((N / 2 : ℕ) : ZMod N)} := by
      intro y hy
      rw [Finset.mem_filter] at hy
      have h1 : (y - y0) + (y - y0) = 0 := by
        have h2 : (y - y0) + (y - y0) = (y + y) - (y0 + y0) := by ring
        rw [h2, hy.2, hy0.2, sub_self]
      rw [Finset.mem_insert, Finset.mem_singleton]
      rcases two_torsion (y - y0) h1 with h | h
      · left
        exact sub_eq_zero.mp h
      · right
        rw [← h]
        ring
    exact (Finset.card_le_card hsub).trans Finset.card_le_two
  · rw [Finset.not_nonempty_iff_eq_empty] at hne
    rw [hne, Finset.card_empty]
    omega

theorem bound {N : ℕ} [NeZero N] (A : Finset (ZMod N))
    (hfree : ∀ x y z : ZMod N,
      ¬ (({x, y, z, x + y, y + z, x + z, x + y + z} : Set (ZMod N)) ⊆ (A : Set (ZMod N)))) :
    3 * A.card ≤ 2 * N := by
  by_cases hx : ∃ x, x ∈ A ∧ x + x ∈ A
  · obtain ⟨x, hxA, hxxA⟩ := hx
    have hB : (A.image (fun a => a - x)).card = A.card :=
      Finset.card_image_of_injective _ sub_left_injective
    have hC : (A.image (fun a => a - x - x)).card = A.card :=
      Finset.card_image_of_injective _ (fun a b h => by
        have h1 : a - x - x + x + x = b - x - x + x + x := by rw [h]
        have h2 : a - x - x + x + x = a := by ring
        have h3 : b - x - x + x + x = b := by ring
        rw [h2, h3] at h1
        exact h1)
    have hint : A ∩ A.image (fun a => a - x) ∩ A.image (fun a => a - x - x) = ∅ := by
      rw [Finset.eq_empty_iff_forall_notMem]
      intro y hy
      rw [Finset.mem_inter, Finset.mem_inter, Finset.mem_image, Finset.mem_image] at hy
      obtain ⟨⟨hyA, b, hbA, hb⟩, c, hcA, hc⟩ := hy
      have hxy : x + y ∈ A := by
        have h1 : x + y = b := by
          rw [← hb]
          ring
        rw [h1]
        exact hbA
      have hxxy : x + x + y ∈ A := by
        have h1 : x + x + y = c := by
          rw [← hc]
          ring
        rw [h1]
        exact hcA
      apply hfree x x y
      intro w hw
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hw
      rw [Finset.mem_coe]
      rcases hw with rfl | rfl | rfl | rfl | rfl | rfl | rfl
      · exact hxA
      · exact hxA
      · exact hyA
      · exact hxxA
      · exact hxy
      · exact hxy
      · exact hxxy
    have h3 := three_sets A (A.image (fun a => a - x)) (A.image (fun a => a - x - x)) hint
    rw [hB, hC, ZMod.card] at h3
    omega
  · have hx' : ∀ x, x ∈ A → x + x ∉ A := fun x hxA hxx => hx ⟨x, hxA, hxx⟩
    have hdisj : Disjoint A (A.image (fun a => a + a)) := by
      rw [Finset.disjoint_left]
      intro y hyA hyD
      rw [Finset.mem_image] at hyD
      obtain ⟨b, hbA, hb⟩ := hyD
      rw [← hb] at hyA
      exact hx' b hbA hyA
    have h1 : A.card + (A.image (fun a => a + a)).card ≤ N := by
      rw [← Finset.card_union_of_disjoint hdisj]
      exact (Finset.card_le_univ _).trans_eq (ZMod.card N)
    have h2 : A.card ≤ 2 * (A.image (fun a => a + a)).card :=
      Finset.card_le_mul_card_image A 2 (fun a _ => fiber_le A a)
    omega

theorem count3 : ∀ M : ℕ,
    ∑ k ∈ Finset.range (3 * M), (if k % 3 = 1 ∨ k % 3 = 2 then 1 else 0) = 2 * M := by
  intro M
  induction M with
  | zero => simp
  | succ M ih =>
    rw [show 3 * (M + 1) = 3 * M + 1 + 1 + 1 by ring, Finset.sum_range_succ,
      Finset.sum_range_succ, Finset.sum_range_succ, ih, if_neg (by omega), if_pos (by omega),
      if_pos (by omega)]
    ring

theorem mod3 : ∀ u v w : ZMod 3, u ≠ 0 → v ≠ 0 → w ≠ 0 → u + v ≠ 0 → v + w ≠ 0 → u + w ≠ 0 →
    u + v + w ≠ 0 → False := by
  decide

theorem tight {N : ℕ} [NeZero N] (h3 : 3 ∣ N) : ∃ A : Finset (ZMod N),
    (∀ a : ZMod N, a ∈ A ↔ a.val % 3 = 1 ∨ a.val % 3 = 2) ∧
    (∀ x y z : ZMod N,
      ¬ (({x, y, z, x + y, y + z, x + z, x + y + z} : Set (ZMod N)) ⊆ (A : Set (ZMod N)))) ∧
    3 * A.card = 2 * N := by
  refine ⟨Finset.univ.filter (fun a : ZMod N => a.val % 3 = 1 ∨ a.val % 3 = 2), ?_, ?_, ?_⟩
  · intro a
    rw [Finset.mem_filter]
    exact ⟨fun h => h.2, fun h => ⟨Finset.mem_univ a, h⟩⟩
  · intro x y z hsub
    have key : ∀ a : ZMod N, a ∈ ((Finset.univ.filter
        (fun a : ZMod N => a.val % 3 = 1 ∨ a.val % 3 = 2) : Finset (ZMod N)) : Set (ZMod N)) →
        (ZMod.castHom h3 (ZMod 3)) a ≠ 0 := by
      intro a ha
      rw [Finset.mem_coe, Finset.mem_filter] at ha
      rw [ZMod.castHom_apply, ← ZMod.natCast_val, Ne, ZMod.natCast_eq_zero_iff]
      omega
    have hx := key x (hsub (by simp))
    have hy := key y (hsub (by simp))
    have hz := key z (hsub (by simp))
    have hxy := key (x + y) (hsub (by simp))
    have hyz := key (y + z) (hsub (by simp))
    have hxz := key (x + z) (hsub (by simp))
    have hxyz := key (x + y + z) (hsub (by simp))
    rw [map_add] at hxy hyz hxz
    rw [map_add, map_add] at hxyz
    exact mod3 _ _ _ hx hy hz hxy hyz hxz hxyz
  · obtain ⟨M, rfl⟩ := h3
    have hcard : (Finset.univ.filter (fun a : ZMod (3 * M) => a.val % 3 = 1 ∨ a.val % 3 = 2)).card
        = ((Finset.range (3 * M)).filter (fun k => k % 3 = 1 ∨ k % 3 = 2)).card := by
      apply Finset.card_bij (fun a _ => a.val)
      · intro a ha
        rw [Finset.mem_filter] at ha
        rw [Finset.mem_filter, Finset.mem_range]
        exact ⟨ZMod.val_lt a, ha.2⟩
      · intro a _ b _ hab
        exact ZMod.val_injective _ hab
      · intro k hk
        rw [Finset.mem_filter, Finset.mem_range] at hk
        have hv : ((k : ℕ) : ZMod (3 * M)).val = k := by
          rw [ZMod.val_natCast]
          exact Nat.mod_eq_of_lt hk.1
        refine ⟨(k : ZMod (3 * M)), ?_, hv⟩
        rw [Finset.mem_filter, hv]
        exact ⟨Finset.mem_univ _, hk.2⟩
    rw [hcard, Finset.card_filter, count3]
    ring

end F2Cube

theorem OMA.solution : type_of% @OMA.S_arxiv_2311_12318.main := by
  intro N _
  refine ⟨fun A hA => F2Cube.bound A hA, fun h3 => F2Cube.tight h3⟩
